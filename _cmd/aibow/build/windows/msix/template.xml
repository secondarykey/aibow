<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="aibow.exe"
        Arguments=""
        InstallLocation="C:\Program Files\secondarykey\aibow">
    </Installer>
    <PackageInformation
        PackageName="aibow"
        PackageDisplayName="aibow"
        PublisherName="CN=secondarykey"
        PublisherDisplayName="secondarykey"
        Version="0.1.0.0"
        PackageDescription="aibow - ローカルLLMを自分で動かして仕組みを学ぶチャット">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.secondarykey.aibow"
                Description="aibow - ローカルLLMを自分で動かして仕組みを学ぶチャット"
                DisplayName="aibow"
                ExecutableName="aibow.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>aibow</DisplayName>
            <PublisherDisplayName>secondarykey</PublisherDisplayName>
            <Description>aibow - ローカルLLMを自分で動かして仕組みを学ぶチャット</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="aibow.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
